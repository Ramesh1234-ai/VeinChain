# Production Environment Variables for Render
# These values must be set in Render dashboard

# Flask Configuration
FLASK_ENV=production
DEBUG=False

# Database (Render automatically provides DATABASE_URL for PostgreSQL)
# DATABASE_URL will be set by Render, but you can override here
# Format: postgresql://user:password@host:5432/dbname

# Secret Keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANT: Generate new keys for production!
SECRET_KEY=GENERATE_AND_SET_IN_RENDER_DASHBOARD
JWT_SECRET_KEY=GENERATE_AND_SET_IN_RENDER_DASHBOARD

# Email Configuration (Gmail App Password recommended)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# Firebase (optional)
# FIREBASE_CONFIG_PATH=/etc/firebase_config.json
