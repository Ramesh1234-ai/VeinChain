# Email Configuration (Change these for production)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here

# Secret Keys (Generate new ones for production)
SECRET_KEY=your_secret_key_here_min_32_chars
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars

# Database
DATABASE_URL=sqlite:///blood_donation.db
# For PostgreSQL on Railway:
# DATABASE_URL=postgresql://user:password@host:5432/veinchain

# Environment
FLASK_ENV=development
DEBUG=False

# CORS Origins (adjust for your domain)
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# Port
PORT=5000

# Session Security
SESSION_COOKIE_SECURE=False
# Set to True in production (requires HTTPS)
